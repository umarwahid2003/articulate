# ====================================================================
# Articulate — Environment Variables Template
# Copy this file to .env.local and fill in your keys.
# DO NOT commit real secrets or API keys to version control.
# ====================================================================

# Groq API Configuration (Ultra-low latency speech evaluation & topic generation)
# Obtain your free API key at https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Configuration (Fallback intelligence)
# Obtain your key at https://aistudio.google.com
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API Configuration (Optional fallback)
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase Configuration (Authentication & User Progress Sync)
# Obtain from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
